# backend/.env.example — backend service config (NO REAL VALUES)
DATABASE_URL=postgresql://role:password@host:5432/dbname
# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
PORT=5000
NODE_ENV=production

# CORS allowlist (comma-separated origins). Defaults applied in server.js if unset.
ALLOWED_ORIGINS=https://your-domain.abacusai.cloud,http://localhost:3000

# ── Booking-only gate (S1B-R2, Beta V1) ───────────────────────
# Online payments are HARD-DISABLED for the Beta release. This flag is
# documentation/telemetry only: the release gate returns false as a code
# constant, so even ONLINE_PAYMENTS_ENABLED=true CANNOT turn payments on.
# Re-enabling online payments is NOT a config change — it requires a new L2
# contract + explicit Majd authorization + code change + tests + release review.
ONLINE_PAYMENTS_ENABLED=false

# ── LUCA AI coach ──────────────────────────────────────────────
# mode: mock | abacus | cloud | anthropic | local
# Abacus RouteLLM is OpenAI-compatible. Pin a model for auditable health-adjacent
# production flows. Use route-llm only for low-risk/nonclinical dynamic routing.
LUCA_AI_MODE=abacus
LUCA_AI_BASE_URL=https://routellm.abacus.ai/v1
LUCA_AI_MODEL=claude-sonnet-4-6
LUCA_AI_API_KEY=REPLACE_WITH_YOUR_ABACUS_ROUTE_LLM_KEY
LUCA_AI_TIMEOUT_MS=20000
# Optional label for a generic OpenAI-compatible cloud endpoint.
LUCA_AI_PROVIDER=
ANTHROPIC_API_KEY=

# ── Cross-chain wallet RPC endpoints (optional overrides) ──────
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
SOLANA_RPC_URL=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
